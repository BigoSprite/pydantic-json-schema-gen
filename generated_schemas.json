    "properties": {
      "meta_data": {
        "$ref": "#/$defs/lme_output_meta"
      },
      "is_final": {
        "description": "Indicates whether the decoder generation has finished.",
        "title": "Is Final",
        "type": "boolean"
      },
      "beam_strings": {
        "description": "The generated text sequences (output strings) from each beam.",
        "items": {
          "type": "string"
        },
        "title": "Beam Strings",
        "type": "array"
      },
      "beam_tokens_nums": {
        "description": "The number of tokens in each beam.",
        "items": {
          "type": "integer"
        },
        "title": "Beam Tokens Nums",
        "type": "array"
      },
      "logits": {
        "additionalProperties": {
          "type": "number"
        },
        "description": "The raw logits output mapped by token ID.",
        "title": "Logits",
        "type": "object"
      },
      "input_tokens_num": {
        "description": "The count of input tokens processed.",
        "title": "Input Tokens Num",
        "type": "integer"
      },
      "feature": {
        "default": "",
        "description": "The MMR embedding feature std::vector[char].",
        "title": "Feature",
        "type": "string"
      }
    },
    "required": [
      "meta_data",
      "is_final",
      "beam_strings",
      "beam_tokens_nums",
      "logits",
      "input_tokens_num"
    ],
    "title": "lme_detokenizer_output",
    "type": "object"
  },
