{
  "lme_detokenizer_input": {
    "$defs": {
      "DataFormat": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "title": "DataFormat",
        "type": "integer"
      },
      "DataType": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "title": "DataType",
        "type": "integer"
      },
      "GraphType": {
        "enum": [
          1,
          2,
          3
        ],
        "title": "GraphType",
        "type": "integer"
      },
      "MemoryType": {
        "enum": [
          0,
          1
        ],
        "title": "MemoryType",
        "type": "integer"
      },
      "Tensor": {
        "properties": {
          "data": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Data"
          },
          "data_type": {
            "$ref": "#/$defs/DataType"
          },
          "memory_type": {
            "$ref": "#/$defs/MemoryType"
          },
          "device_id": {
            "title": "Device Id",
            "type": "integer"
          },
          "dims": {
            "items": {
              "type": "integer"
            },
            "title": "Dims",
            "type": "array"
          },
          "format": {
            "$ref": "#/$defs/DataFormat"
          }
        },
        "required": [
          "data_type",
          "memory_type",
          "device_id",
          "dims",
          "format"
        ],
        "title": "Tensor",
        "type": "object"
      },
      "lme_input_meta": {
        "properties": {
          "graph_type": {
            "$ref": "#/$defs/GraphType"
          },
          "request_id": {
            "title": "Request Id",
            "type": "integer"
          },
          "operation": {
            "default": 1,
            "description": "Process selection field, with values as powers of 2(2^n): pre = 1, tok = 2, vit = 4, llm = 8, dtk = 16.",
            "title": "Operation",
            "type": "integer"
          }
        },
        "required": [
          "graph_type",
          "request_id"
        ],
        "title": "lme_input_meta",
        "type": "object"
      },
      "lme_llm_output": {
        "properties": {
          "meta_data": {
            "$ref": "#/$defs/lme_output_meta"
          },
          "is_final": {
            "description": "Indicates whether the decoder generation has finished.",
            "title": "Is Final",
            "type": "boolean"
          },
          "beam_tokens": {
            "description": "The generated token sequences (output IDs) from each beam.",
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "title": "Beam Tokens",
            "type": "array"
          },
          "advance_output": {
            "additionalProperties": {
              "$ref": "#/$defs/Tensor"
            },
            "description": "Intermediate output tensors for advanced processing (e.g., logits, KV-cache).",
            "title": "Advance Output",
            "type": "object"
          },
          "dictionary_index": {
            "description": "The index corresponding to the selected token in the model's vocabulary.",
            "title": "Dictionary Index",
            "type": "integer"
          },
          "search_tokens": {
            "description": "The token sequences resulting from the search algorithm (e.g., beam search).",
            "items": {
              "type": "integer"
            },
            "title": "Search Tokens",
            "type": "array"
          },
          "input_tokens_num": {
            "description": "The total count of input tokens processed by the model.",
            "title": "Input Tokens Num",
            "type": "integer"
          }
        },
        "required": [
          "meta_data",
          "is_final",
          "beam_tokens",
          "advance_output",
          "dictionary_index",
          "search_tokens",
          "input_tokens_num"
        ],
        "title": "lme_llm_output",
        "type": "object"
      },
      "lme_output_meta": {
        "properties": {
          "graph_type": {
            "$ref": "#/$defs/GraphType"
          },
          "status_msg": {
            "title": "Status Msg",
            "type": "string"
          },
          "status_code": {
            "title": "Status Code",
            "type": "integer"
          },
          "request_id": {
            "title": "Request Id",
            "type": "integer"
          }
        },
        "required": [
          "graph_type",
          "status_msg",
          "status_code",
          "request_id"
        ],
        "title": "lme_output_meta",
        "type": "object"
      }
    },
    "properties": {
      "meta_data": {
        "$ref": "#/$defs/lme_input_meta"
      },
      "llm_data": {
        "$ref": "#/$defs/lme_llm_output",
        "description": "The LLM's output is fed into the detokenizer."
      }
    },
    "required": [
      "meta_data",
      "llm_data"
    ],
    "title": "lme_detokenizer_input",
    "type": "object"
  },
  "lme_detokenizer_output": {
    "$defs": {
      "GraphType": {
        "enum": [
          1,
